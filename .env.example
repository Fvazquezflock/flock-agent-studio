# Multi-Agent Orchestration Studio — configuración local de ejemplo.
# Copiá este archivo a .env (scripts/setup.ps1 lo hace y genera MAO_OWNER_TOKEN).
# Nunca subas .env al repositorio.

# --- PostgreSQL embebido local (pnpm db:start) o Docker, solo loopback ---
MAO_DB_PORT=5433
MAO_DB_USER=mao
MAO_DB_PASSWORD=mao_local_dev

# --- Base de trabajo (API, worker, seed, migraciones) ---
DATABASE_URL=postgresql://mao:mao_local_dev@127.0.0.1:5433/mao?schema=public
# Alternativa remota (Railway): usá la URL pública del servicio PostgreSQL (Variables → DATABASE_PUBLIC_URL)
# y agregá schema=public y sslmode=require (Railway acepta conexiones sin TLS: no lo omitas).
# DATABASE_URL=postgresql://postgres:<contraseña>@<host>.proxy.rlwy.net:<puerto>/railway?schema=public&sslmode=require&connect_timeout=15
# Pasar datos de una base a otra: node scripts/db-copy.mjs --from local --to DATABASE_URL (ver README).
# Timeouts de transacciones interactivas (ms); los valores por defecto contemplan una base remota.
# MAO_DB_TX_MAX_WAIT_MS=10000
# MAO_DB_TX_TIMEOUT_MS=60000

# --- Pruebas de integración: siempre mao_test local (se recrea en cada corrida) ---
TEST_DATABASE_URL=postgresql://mao:mao_local_dev@127.0.0.1:5433/mao_test?schema=public

# --- API (solo loopback) ---
MAO_API_HOST=127.0.0.1
MAO_API_PORT=4317
MAO_API_URL=http://127.0.0.1:4317
# Token del propietario local: lo usan la CLI y el proxy de la UI. setup.ps1 lo genera.
MAO_OWNER_TOKEN=
MAO_OWNER_NAME=Propietario local

# --- Web ---
MAO_WEB_PORT=3000

# --- Worker ---
MAO_WORKER_CONCURRENCY=2
MAO_WORKER_POLL_MS=1000

# --- Jira vía MCP existente (stdio). Rutas relativas a la raíz del repo. ---
MAO_JIRA_MCP_COMMAND=MCP/mcp-atlassian/.venv/Scripts/mcp-atlassian.exe
MAO_JIRA_MCP_ARGS=--env-file MCP/mcp-atlassian/.env
# Escrituras reales en Jira: deshabilitadas salvo habilitación explícita (además de la conexión y la política).
MAO_ALLOW_JIRA_WRITES=false

# --- Archivos del catálogo (fuente de verdad versionada en el repo) ---
# Carpeta con agentes, skills, orquestadores y configuración sin secretos. Relativa a la raíz del repo (por defecto catalog).
# MAO_CATALOG_DIR=catalog
# Sincronización al arrancar la API: sync (por defecto: exporta lo aprobado e importa los archivos cambiados como versiones
# pendientes de aprobación), export (solo escribe desde la base) u off. Nunca activa nada solo; la configuración editada
# a mano se aplica con pnpm mao files apply o desde la página Archivos.
MAO_CATALOG_SYNC=sync

# --- Datos de demostración ---
# true: el seed crea el proyecto DEMO (datos ficticios) y el proveedor simulado. Por defecto no: solo Jira registrado y Claude Code.
MAO_SEED_DEMO=false

# --- Proveedores de IA ---
# Binario de Claude Code para el runner local (requiere `claude auth login`).
MAO_CLAUDE_BIN=claude
# API de Anthropic (opcional). Solo se lee el nombre de la variable desde la configuración.
ANTHROPIC_API_KEY=
