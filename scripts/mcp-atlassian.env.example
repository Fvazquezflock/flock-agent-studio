# Credenciales del servidor MCP de Jira (mcp-atlassian). scripts\setup-mcp.ps1 copia este archivo a
# MCP\mcp-atlassian\.env, que está ignorado por git. Nunca subas ese .env al repositorio.

# Jira Cloud: URL del sitio, email de la cuenta y token de API
# (https://id.atlassian.com/manage-profile/security/api-tokens).
JIRA_URL=https://tu-sitio.atlassian.net
JIRA_USERNAME=tu.email@empresa.com
JIRA_API_TOKEN=

# Opcional: limitar los proyectos visibles (claves separadas por coma).
#JIRA_PROJECTS_FILTER=SCRUM

# No hace falta configurar READ_ONLY_MODE: la plataforma abre un proceso de solo lectura para leer y uno
# restringido (ENABLED_TOOLS) solo para publicar lo aprobado, y las escrituras siguen deshabilitadas salvo
# MAO_ALLOW_JIRA_WRITES=true y la habilitación explícita de la conexión.
